PORT= #Porta em que o servidor estará escutando
DB_HOST= #Endereço do host do banco de dados MySQL
DB_USER= #Nome de usuário para autenticação no banco de dados MySQL
DB_PASSWORD= #Senha para autenticação no banco de dados MySQL
DB_DATABASE= #Nome do banco de dados MySQL que será utilizado
DB_PORT= #Porta em que o banco de dados MySQL está escutando (padrão é 3306)